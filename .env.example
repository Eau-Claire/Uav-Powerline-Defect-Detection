# Copy to .env (never commit .env) and `set -a; source .env; set +a` before running.
# The Camber key can also come from `camber login` credentials.
CAMBER_API_KEY=

# Optional: path to the camber CLI if not on PATH or ~/.camber/bin
# CAMBER_BIN=/home/you/.camber/bin/camber

# Optional: force the runtime environment (local | kaggle | camber)
# YOLOV11SDI_ENV=local

# Optional: put bulky data/ (archives, datasets) on another disk
# YOLOV11SDI_DATA_ROOT=/mnt/bigdisk/yolov11sdi_data

# Optional: move data/artifacts/state/logs/runs elsewhere entirely
# YOLOV11SDI_HOME=/mnt/bigdisk/yolov11sdi


# - lr scheduler: ReduceLRonPlateau (factor=0.5) (recommend)
# - optimizer: AdamW (weight decay=0.001) (recommend)
# - tăng epoch lên 100 nhưng set up thêm early stop sau 7 epoch loss ko giảm or mAP ko tăng (để coi thử ngưỡng epoch tối ưu là bnhiu thui, cố định 40 thì mik ch chắc nóa tăng nx hôk nếu train thêm)
# - thử tăng nhẹ weight box loss (+1 or +2 thoy) (tutu thử)
# - thử tăng nhẹ weight dfl loss (+0.25 or 0.5) (bìn tĩn)
# - tắt mosaic ở 5 or 10 epoch cuối (chua ưu tiên lắm)