# Optional; defaults to the curated YOLO26n checkpoint in the repository.
# Relative paths are resolved from the repository root.
MODEL_PATH=benchmakring_transmission_line_defect_model/runs/curated_yolo26n/weights/best.pt

# IP Camera Lite: use the MJPEG URL shown in the app (usually /video).
# Prefer the LAN URL when the PC and phone are on the same Wi-Fi.
CAMERA_STREAM_URL=

# Alternative RTSP configuration for cameras that provide an RTSP stream:
# CAMERA_RTSP_URL=rtsp://username:password@192.168.1.100:554/stream1
# Or configure RTSP from its separate parts:
CAMERA_IP=
CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH=/stream1
CAMERA_USERNAME=
CAMERA_PASSWORD=
